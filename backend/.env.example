# CARFIXZI FastAPI Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000","http://10.0.2.2:8000","*"]

# GroqCloud API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groqcloud_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary Storage Configuration (Get from https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Regional Pilot Defaults (Sahiwal District, Punjab, Pakistan)
DEFAULT_REGION=sahiwal_punjab
COMMISSION_RATE_SERVICES_BPS=1000
COMMISSION_RATE_PARTS_BPS=500
